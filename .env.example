# --- LLM (xAI / Grok, OpenAI-compatible) ---
XAI_API_KEY=your-xai-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# --- App metadata DB (PostgreSQL) ---
METADATA_DB_URL=postgresql+psycopg://app:app@localhost:5432/appmeta

# Fernet key used to encrypt saved DB passwords:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Optional bearer token protecting the API (UI sends it automatically)
API_TOKEN=

# --- SQL safety ---
SQL_TIMEOUT_S=15
SQL_DEFAULT_LIMIT=1000
SQL_MAX_ROWS=10000
SQL_MAX_RETRIES=2
REQUIRE_READONLY_ROLE=true
# Send a few distinct categorical values to the LLM (helps filters). Off by default for privacy.
SEND_SAMPLE_VALUES_TO_LLM=false

API_BASE_URL=http://localhost:8000
